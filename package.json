{
  "name": "code-archaeology",
  "displayName": "Code Archaeologist",
  "description": "Point at any code, get a one-line answer to 'why is this here?' — backed by commits, PRs, and issues.",
  "version": "0.1.3",
  "publisher": "frankliu20",
  "license": "MIT",
  "icon": "media/icon.png",
  "author": {
    "name": "Frank Liu"
  },
  "homepage": "https://github.com/frankliu20/code-archaeology#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankliu20/code-archaeology.git"
  },
  "bugs": {
    "url": "https://github.com/frankliu20/code-archaeology/issues"
  },
  "keywords": [
    "git",
    "blame",
    "history",
    "archaeology",
    "pull requests",
    "code review",
    "github"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "codeArchaeology.investigateSelection",
        "title": "🏺 Why is this here?",
        "category": "Archaeology"
      }
    ],
    "keybindings": [
      {
        "command": "codeArchaeology.investigateSelection",
        "key": "ctrl+shift+y",
        "mac": "cmd+shift+y",
        "when": "editorHasSelection || editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codeArchaeology.investigateSelection",
          "group": "navigation@99",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "smoke": "node out/smoke.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
